---
import type { Copy } from '../i18n/content';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const { heading, items } = copy.traits;
---

<section aria-labelledby="traits-title" class="bg-surface py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <h2 id="traits-title" class="reveal text-4xl font-semibold tracking-tight md:text-6xl">{heading}</h2>
    <ul class="mt-14 grid gap-12 md:mt-20 md:gap-16">
      {
        items.map((item, i) => (
          <li class:list={['reveal max-w-3xl', i === 1 && 'md:ml-[16%]', i === 2 && 'md:ml-[32%]']}>
            <p class="text-2xl font-semibold tracking-tight md:text-4xl">{item.title}</p>
            <p class="mt-3 text-lg leading-relaxed text-muted md:text-xl">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
