{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Static web developer portfolio for Antoine Oparin",
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./styles.css -o ./output.css --minify && node scripts/build.mjs",
    "dev": "npx @tailwindcss/cli -i ./styles.css -o ./output.css --watch",
    "preview": "npm run build -- --drafts && node scripts/preview.mjs"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "marked": "18.0.14",
    "tailwindcss": "^4.1.18"
  }
}
